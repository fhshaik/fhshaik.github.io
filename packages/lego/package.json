{
  "name": "@fhshaik/lego",
  "version": "0.1.0",
  "private": true,
  "description": "A LEGO-style building-block library: procedural three.js bricks and a matching 2D UI kit, sharing one token set.",
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./core": "./src/core/index.ts",
    "./react": "./src/react/index.ts",
    "./ui": "./src/ui/index.ts",
    "./lego.css": "./src/ui/lego.css"
  },
  "files": ["src"],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "three": ">=0.180"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  }
}
